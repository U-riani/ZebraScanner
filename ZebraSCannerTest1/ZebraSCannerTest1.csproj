<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			$(TargetFrameworks);net9.0-windows10.0.19041.0
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ZebraSCannerTest1</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>ScanMate</ApplicationTitle>
		<ApplicationId>com.companyname.zebrascannertest1</ApplicationId>

		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<!-- DEBUG ANDROID -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">

		<RuntimeIdentifiers>android-arm64;android-arm;android-x64;android-x86</RuntimeIdentifiers>

		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<AndroidSigningKeyStore>D:\My Projects\csharp\ZebraSCannerTest1\myapp.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>123456</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>myalias</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>123456</AndroidSigningKeyPass>

		<TargetSdkVersion>34</TargetSdkVersion>

		<AndroidSupportedAbis>arm64-v8a;armeabi-v7a;x86_64;x86</AndroidSupportedAbis>

		<EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
		<PublishTrimmed>false</PublishTrimmed>
		<MauiTrimMode>none</MauiTrimMode>

	</PropertyGroup>

	<!-- RELEASE ANDROID -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">

		<RuntimeIdentifiers>android-arm64;android-arm;android-x64;android-x86</RuntimeIdentifiers>

		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<AndroidSigningKeyStore>D:\My Projects\csharp\ZebraSCannerTest1\myapp.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>123456</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>myalias</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>123456</AndroidSigningKeyPass>

		<TargetSdkVersion>34</TargetSdkVersion>

		<PublishTrimmed>false</PublishTrimmed>
		<MauiTrimMode>none</MauiTrimMode>
		<RunAOTCompilation>false</RunAOTCompilation>
		<DebugSymbols>True</DebugSymbols>

	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="8.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="MiniExcel" Version="1.32.0" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="UI\Views\Controls\HeaderBar.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\DetailsPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\HomePage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\InventorizationByLootsMenuPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\InventorizationByLootsPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\InventorizationMenuPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\InventoryMenuPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\LoginPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="UI\Views\LootsScanningPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\Popups\ExportProgressPopup.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\LogsPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\Popups\ManualFilterPopup.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\Popups\ProgressPopup.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\Popups\SectionPopup.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\SalesMenuPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\SalesPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\ScannedProductsPage.xaml" Generator="MSBuild:Compile" />
		<MauiXaml Update="UI\Views\SettingsPage.xaml" Generator="MSBuild:Compile" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Features\Inventory\" />
		<Folder Include="Features\ImportExport\" />
		<Folder Include="Features\Scanning\" />
		<Folder Include="Database\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="UI\Views\InventorizationPage.xaml.cs" DependentUpon="InventorizationPage.xaml" />
		<Compile Update="UI\Views\InventoryMenuPage.xaml.cs" DependentUpon="InventoryMenuPage.xaml" />
	</ItemGroup>

</Project>