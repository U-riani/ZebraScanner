<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ZebraSCannerTest1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ZebraSCannerTest1.UI.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="#0026B7"
    Shell.TitleColor="White"
    Shell.NavBarHasShadow="False"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Dark=#0A0F1A, Light=#FFFFFF}">

    <!-- Custom burger menu icon on RIGHT side -->
    <Shell.ToolbarItems>
        <ToolbarItem IconImageSource="menu.png"
                     Order="Secondary" 
            Priority="0"
                     Command="{Binding OpenMenuCommand}" />
    </Shell.ToolbarItems>

    <!-- Global TitleView with logo + title (centered) -->
    <Shell.TitleView>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
            <Image Source="logo2.png" HeightRequest="28" WidthRequest="28" />
            <Label Text="ScanMate"
                   FontAttributes="Bold"
                   FontSize="18"
                   VerticalOptions="Center"
                   TextColor="White" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <!-- Flyout Menu Items (side menu content) -->
    <FlyoutItem Title="Home"
                Icon="home.svg">
        <ShellContent Route="Home" ContentTemplate="{DataTemplate views:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Loots Scanning"
                Icon="qrcode_viewfinder.svg">
        <ShellContent Route="LootsScanning" ContentTemplate="{DataTemplate views:LootsScanningPage}" />
    </FlyoutItem>

    <!-- Add more FlyoutItems as needed (e.g. Settings) -->
    <!-- <FlyoutItem Title="Settings" Icon="gearshape.svg">
        <ShellContent Route="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem> -->

    <!-- Optional: Bottom TabBar – only if you want tabs at the bottom -->
    <TabBar>
        <Tab Title="Scanning" Icon="qrcode_viewfinder.svg">
            <ShellContent Route="LootsScanning" ContentTemplate="{DataTemplate views:LootsScanningPage}" />
        </Tab>
        <!-- Add more tabs if needed -->
    </TabBar>

</Shell>