<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════
         DARK GLASS OPS — Color Palette
    ═══════════════════════════════════════════ -->

    <!-- Backgrounds -->
    <Color x:Key="DeepBg">#0A0A0F</Color>
    <Color x:Key="GlassBg">#141428</Color>
    <Color x:Key="GlassCard">#1C1C38</Color>
    <Color x:Key="GlassCardAlt">#12122A</Color>
    <Color x:Key="GlassHeader">#0D0D22</Color>

    <!-- Accents -->
    <Color x:Key="CyanAccent">#00D4FF</Color>
    <Color x:Key="CyanDim">#0099BB</Color>
    <Color x:Key="CyanGlow">#1A00D4FF</Color>
    <Color x:Key="VioletAccent">#7B2FFF</Color>
    <Color x:Key="VioletDim">#5A1FBB</Color>
    <Color x:Key="VioletGlow">#1A7B2FFF</Color>

    <!-- Glass Borders (20% opacity) -->
    <Color x:Key="GlassBorderCyan">#3300D4FF</Color>
    <Color x:Key="GlassBorderViolet">#337B2FFF</Color>
    <Color x:Key="GlassBorderMuted">#26FFFFFF</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#E8EAED</Color>
    <Color x:Key="TextSecondary">#6B7A8D</Color>
    <Color x:Key="TextMuted">#3D4A5C</Color>
    <Color x:Key="TextCyan">#00D4FF</Color>
    <Color x:Key="TextViolet">#A066FF</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#00C97B</Color>
    <Color x:Key="DangerColor">#FF4757</Color>
    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="InfoColor">#00D4FF</Color>

    <!-- Status Glass Backgrounds -->
    <Color x:Key="SuccessGlass">#1A3A2A</Color>
    <Color x:Key="DangerGlass">#3A1A1F</Color>
    <Color x:Key="WarningGlass">#3A2E00</Color>

    <!-- Legacy (kept for compatibility) -->
    <Color x:Key="Primary">#7B2FFF</Color>
    <Color x:Key="PrimaryDark">#A066FF</Color>
    <Color x:Key="PrimaryDarkText">#E8EAED</Color>
    <Color x:Key="Secondary">#00D4FF</Color>
    <Color x:Key="SecondaryDarkText">#0A0A0F</Color>
    <Color x:Key="Tertiary">#0D0D22</Color>

    <Color x:Key="White">#E8EAED</Color>
    <Color x:Key="Black">#0A0A0F</Color>
    <Color x:Key="Magenta">#FF2D78</Color>
    <Color x:Key="MidnightBlue">#0D0D22</Color>
    <Color x:Key="OffBlack">#141428</Color>

    <Color x:Key="Gray100">#3D4A5C</Color>
    <Color x:Key="Gray200">#2E3A4A</Color>
    <Color x:Key="Gray300">#1F2A38</Color>
    <Color x:Key="Gray400">#1A2030</Color>
    <Color x:Key="Gray500">#141928</Color>
    <Color x:Key="Gray600">#0F1220</Color>
    <Color x:Key="Gray900">#0A0D18</Color>
    <Color x:Key="Gray950">#07090F</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="DeepBgBrush" Color="{StaticResource DeepBg}"/>
    <SolidColorBrush x:Key="GlassCardBrush" Color="{StaticResource GlassCard}"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccent}"/>
    <SolidColorBrush x:Key="VioletAccentBrush" Color="{StaticResource VioletAccent}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>
