<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ZebraSCannerTest1.ViewModels"
             xmlns:models="clr-namespace:ZebraSCannerTest1.Models"
             x:Class="ZebraSCannerTest1.Views.ScannedProductsPage"
             x:DataType="viewmodel:ScannedProductsViewModel"
             xmlns:converters="clr-namespace:ZebraSCannerTest1.Converters"
             Title="Scanned Products">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DifferenceToColorConverter x:Key="DiffToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,2*">
        <!-- Status labels -->
        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Padding="8">
            <Label Text="{Binding CurrentSortDescription}" TextColor="Gray" FontSize="12"/>
            <Label Text="{Binding CurrentFilterDescription}" TextColor="Gray" FontSize="12"/>
        </VerticalStackLayout>

        <!-- Buttons -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="3" Padding="0,5,8,5" Spacing="8">
            <Button Text="Sort" Command="{Binding SortCommand}" Padding="10"/>
            <Button Text="Filter" Command="{Binding FilterCommand}" Padding="10"/>
            <Button Text="Clear" Command="{Binding ClearFilterCommand}" Padding="10"/>
            <Button Text="Mnl Fltr" Clicked="OnManualFilterClicked" Padding="10" BackgroundColor="#0078D7" TextColor="White"/>

        </HorizontalStackLayout>

        <!-- Header row -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2"
              Padding="4"
              ColumnDefinitions="2*,*,*,*"
              BackgroundColor="#EEEEEE">
            <Label Grid.Column="0" Text="Barcode" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Start"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
            <Label Grid.Column="1" Text="Scanned" 
                   HorizontalTextAlignment="Start" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
            <Label Grid.Column="2" Text="Initial" 
                   HorizontalTextAlignment="Start" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
            <Label Grid.Column="3" Text="Diff" 
                   HorizontalTextAlignment="End" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"/>
        </Grid>

        <!-- Product list -->
        <CollectionView 
            Grid.Row="2" Grid.ColumnSpan="2"
            ItemsSource="{Binding ScannedProductsStats}"
            VerticalScrollBarVisibility="Always"
            BackgroundColor="Transparent">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:StatsProduct">
                    <Grid Padding="4" ColumnDefinitions="2*,*,*,*" 
                          BackgroundColor="{Binding Difference, Converter={StaticResource DiffToColor}}"
                          >
                        <Label TextColor="{AppThemeBinding Light=Black, Dark=White}" Text="{Binding Barcode}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.CopyBarcodeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                    CommandParameter="{Binding Barcode}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label HorizontalTextAlignment="Center" Grid.Column="1" Text="{Binding ScannedQuantity}" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label HorizontalTextAlignment="Center" Grid.Column="2" Text="{Binding InitialQuantity}" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Grid.Column="3" Text="{Binding Difference}" TextColor="{AppThemeBinding Light=Black, Dark=White}" HorizontalTextAlignment="End"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
