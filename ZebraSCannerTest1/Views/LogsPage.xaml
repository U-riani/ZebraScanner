<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZebraSCannerTest1.Views.LogsPage"
             Title="Logs">

    <VerticalStackLayout Padding="2" Spacing="0">
        <!-- Header -->
        <HorizontalStackLayout HorizontalOptions="Center" Padding="6" Spacing="12">
            <Button Text="Filter" Command="{Binding FilterCommand}" />
            <Button Text="Clear" Command="{Binding ClearFilterCommand}" />
        </HorizontalStackLayout>
        
        <Grid ColumnDefinitions="2*,*,*,*,2*" Padding="6,4">
            <Label Text="Barcode" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="was" Grid.Column="1" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="IncBy" Grid.Column="2" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Is" Grid.Column="3" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Time" Grid.Column="4" HorizontalTextAlignment="End" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
        </Grid>

        <!-- Static 10 slots -->
        <Grid ColumnDefinitions="3*,*,*,*,2*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3" Padding="4">

            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Slots[0].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[0].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Slots[0].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding Slots[0].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="0" Grid.Column="3" Text="{Binding Slots[0].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="0" Grid.Column="4" Text="{Binding Slots[0].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>

           
            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Slots[1].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[1].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Slots[1].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding Slots[1].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="1" Grid.Column="3" Text="{Binding Slots[1].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="1" Grid.Column="4" Text="{Binding Slots[1].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            
            
            <Label Grid.Row="2" Grid.Column="0" Text="{Binding Slots[2].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[2].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Slots[2].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding Slots[2].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="2" Grid.Column="3" Text="{Binding Slots[2].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="2" Grid.Column="4" Text="{Binding Slots[2].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
           
            
            <Label Grid.Row="3" Grid.Column="0" Text="{Binding Slots[3].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[3].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Slots[3].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding Slots[3].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="3" Grid.Column="3" Text="{Binding Slots[3].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="3" Grid.Column="4" Text="{Binding Slots[3].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            
            
            <Label Grid.Row="4" Grid.Column="0" Text="{Binding Slots[4].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[4].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="4" Grid.Column="1" Text="{Binding Slots[4].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="4" Grid.Column="2" Text="{Binding Slots[4].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="4" Grid.Column="3" Text="{Binding Slots[4].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="4" Grid.Column="4" Text="{Binding Slots[4].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            
           
            <Label Grid.Row="5" Grid.Column="0" Text="{Binding Slots[5].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[5].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="5" Grid.Column="1" Text="{Binding Slots[5].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="5" Grid.Column="2" Text="{Binding Slots[5].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="5" Grid.Column="3" Text="{Binding Slots[5].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="5" Grid.Column="4" Text="{Binding Slots[5].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            
            
            <Label Grid.Row="6" Grid.Column="0" Text="{Binding Slots[6].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[6].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="6" Grid.Column="1" Text="{Binding Slots[6].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="6" Grid.Column="2" Text="{Binding Slots[6].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="6" Grid.Column="3" Text="{Binding Slots[6].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="6" Grid.Column="4" Text="{Binding Slots[6].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            
            
            <Label Grid.Row="7" Grid.Column="0" Text="{Binding Slots[7].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[7].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="7" Grid.Column="1" Text="{Binding Slots[7].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="7" Grid.Column="2" Text="{Binding Slots[7].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="7" Grid.Column="3" Text="{Binding Slots[7].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="7" Grid.Column="4" Text="{Binding Slots[7].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>


            <Label Grid.Row="8" Grid.Column="0" Text="{Binding Slots[8].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[8].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="8" Grid.Column="1" Text="{Binding Slots[8].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="8" Grid.Column="2" Text="{Binding Slots[8].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="8" Grid.Column="3" Text="{Binding Slots[8].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="8" Grid.Column="4" Text="{Binding Slots[8].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>


            <Label Grid.Row="9" Grid.Column="0" Text="{Binding Slots[9].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[9].Barcode}" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Row="9" Grid.Column="1" Text="{Binding Slots[9].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"></Label>
            <Label Grid.Row="9" Grid.Column="2" Text="{Binding Slots[9].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="9" Grid.Column="3" Text="{Binding Slots[9].IsValue}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Grid.Row="9" Grid.Column="4" Text="{Binding Slots[9].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}"/>

        </Grid>

        <!-- Pagination controls -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
            <Button Text="Prev" Command="{Binding PrevPageCommand}" />
            <Label Text="{Binding CurrentPage}" VerticalOptions="Center"  TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="/" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="{Binding TotalPages}" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Button Text="Next" Command="{Binding NextPageCommand}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
