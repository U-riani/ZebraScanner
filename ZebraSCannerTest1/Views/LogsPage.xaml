<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ZebraSCannerTest1.Converters"
             x:Class="ZebraSCannerTest1.Views.LogsPage"
             Title="Logs">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ManualToColorConverter x:Key="ManualToColor"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="2" Spacing="0">

        <!-- Header -->
        <HorizontalStackLayout HorizontalOptions="Center" Padding="6" Spacing="12">
            <Button Text="Filter" Command="{Binding FilterCommand}" />
            <Button Text="Clear" Command="{Binding ClearFilterCommand}" />
        </HorizontalStackLayout>

        <!-- Column Titles -->
        <Grid ColumnDefinitions="2*,*,*,*,2*" Padding="6,4">
            <Label Text="Barcode" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="was" Grid.Column="1" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="IncBy" Grid.Column="2" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Is" Grid.Column="3" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Time" Grid.Column="4" HorizontalTextAlignment="End" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
        </Grid>

        <!-- Slots (10 rows) -->
        <VerticalStackLayout Spacing="3" Padding="4">

            <!-- Row 0 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[0].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[0].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[0].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[0].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[0].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[0].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[0].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 1 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[1].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[1].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[1].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[1].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[1].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[1].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[1].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 2 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[2].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[2].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[2].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[2].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[2].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[2].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[2].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 3 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[3].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[3].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[3].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[3].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[3].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[3].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[3].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 4 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[4].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[4].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[4].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[4].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[4].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[4].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[4].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 5 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[5].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[5].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[5].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[5].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[5].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[5].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[5].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 6 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[6].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[6].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[6].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[6].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[6].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[6].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[6].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 7 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[7].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[7].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[7].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[7].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[7].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[7].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[7].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 8 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[8].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[8].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[8].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[8].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[8].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[8].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[8].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

            <!-- Row 9 -->
            <HorizontalStackLayout Padding="4"
                                   BackgroundColor="{Binding Slots[9].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Text="{Binding Slots[9].Barcode}" WidthRequest="180" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[9].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="{Binding Slots[9].Was}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[9].IncrementBy}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[9].IsValue}" WidthRequest="60" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Text="{Binding Slots[9].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

        <!-- Pagination controls -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,6,0,0">
            <Button Text="Prev" Command="{Binding PrevPageCommand}" />
            <Label Text="{Binding CurrentPage}" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="/" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="{Binding TotalPages}" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Button Text="Next" Command="{Binding NextPageCommand}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
