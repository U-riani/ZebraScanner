                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[3].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[3].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[3].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[3].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[3].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[3].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 4 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[4].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[4].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[4].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[4].Was}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[4].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[4].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[4].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[4].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 5 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[5].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[5].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[5].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[5].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[5].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[5].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[5].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[5].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 6 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[6].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[6].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[6].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[6].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[6].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[6].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[6].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[6].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 7 -->
            <Grid  ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[7].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[7].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[7].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[7].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[7].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[7].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[7].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[7].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 8 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[8].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[8].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[8].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[8].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[8].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[8].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[8].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[8].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 9 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[9].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[9].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[9].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[9].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[9].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[9].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[9].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[9].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

        </VerticalStackLayout>

        <!-- Pagination controls -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,6,0,0">
            <Button Text="Prev" Command="{Binding PrevPageCommand}" />
            <Label Text="{Binding CurrentPage}" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="/" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="{Binding TotalPages}" VerticalOptions="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Button Text="Next" Command="{Binding NextPageCommand}" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
