<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ZebraSCannerTest1.Converters"
             x:Class="ZebraSCannerTest1.Views.LogsPage"
             Title="Logs">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ManualToColorConverter x:Key="ManualToColor"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="2" Spacing="0">

        <!-- Header -->
        <HorizontalStackLayout HorizontalOptions="Center" Padding="6" Spacing="12">
            <Button Text="Barcode" Command="{Binding FilterByBarcodeCommand}" />
            <Button Text="Filter Time" Command="{Binding FilterTimeCommand}" />
            <Button Text="Clear" Command="{Binding ClearFilterCommand}" />
        </HorizontalStackLayout>

        <!-- Column Titles -->
        <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="6,4" >
            <Label Text="Barcode" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="was" Grid.Column="1" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="IncBy" Grid.Column="2" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Is" Grid.Column="3" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Section" Grid.Column="4" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
            <Label Text="Time" Grid.Column="5" HorizontalTextAlignment="End" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
        </Grid>

        <!-- Slots (10 rows) -->
        <VerticalStackLayout Spacing="2">
            <ActivityIndicator 
                IsRunning="True"
                IsVisible="{Binding IsLoading}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Color="#0078D7"/>

            <!-- Row 0 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0" Margin="0,4,0,0"
                                   BackgroundColor="{Binding Slots[0].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[0].Barcode}"  TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[0].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[0].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[0].IncrementBy}" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[0].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[0].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[0].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 1 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[1].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[1].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[1].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[1].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[1].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[1].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[1].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[1].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 2 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[2].IsManual, Converter={StaticResource ManualToColor}}">
                <Label Grid.Column="0" VerticalTextAlignment="Center" Text="{Binding Slots[2].Barcode}" TextColor="{AppThemeBinding Dark=white, Light=black}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}" CommandParameter="{Binding Slots[2].Barcode}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" VerticalTextAlignment="Center" Text="{Binding Slots[2].Was}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="2" VerticalTextAlignment="Center" Text="{Binding Slots[2].IncrementBy}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="3" VerticalTextAlignment="Center" Text="{Binding Slots[2].IsValue}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="4" VerticalTextAlignment="Center" Text="{Binding Slots[2].Section}"  HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Dark=white, Light=black}"/>
                <Label Grid.Column="5" VerticalTextAlignment="Center" Text="{Binding Slots[2].UpdatedAt, StringFormat='{0:dd/MM/yy HH:mm:ss}'}" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Dark=white, Light=black}" />
            </Grid>

            <!-- Row 3 -->
            <Grid ColumnDefinitions="3*,*,*,*,*,2*" Padding="4,0"
                                   BackgroundColor="{Binding Slots[3].IsManual, Converter={StaticResource ManualToColor}}">
