<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZebraSCannerTest1.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fast Scanner">

    <VerticalStackLayout Padding="12" Spacing="12">

        <!-- Current scanned barcode big and obvious -->
        <Label Text="{Binding ShowCurrentBarcode}"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />

        <!-- Manual entry toggle -->
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
            <Entry x:Name="barcodeEntry"
                   Grid.Column="0"
                   IsVisible="{Binding IsManualEntryVisible}"
                   Placeholder="Scan or type barcode…"
                   ReturnType="Done"
                   ClearButtonVisibility="WhileEditing"
                   Text="{Binding CurrentBarcode}" 
                   TextColor="Black"/>

            <Button Grid.Column="1"
                    Text="{Binding IsManualEntryVisible, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Hide,Show'}"
                    Command="{Binding ToggleManualEntryCommand}" />
        </Grid>

        <!-- Header -->
        <Grid ColumnDefinitions="2*,*,*" RowDefinitions="Auto" Padding="6,4">
            <Label Text="Barcode" FontAttributes="Bold" />
            <Label Text="Scanned" Grid.Column="1" HorizontalTextAlignment="Center" FontAttributes="Bold" />
            <Label Text="Initial" Grid.Column="2" HorizontalTextAlignment="End" FontAttributes="Bold" />
        </Grid>

        <!-- 8 STATIC SLOTS: rows never move; we only overwrite values -->
        <Grid ColumnDefinitions="2*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Padding="6" RowSpacing="6">
            <!-- Row 0 -->
            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Slots[0].Barcode}" TextColor="Black"/>
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Slots[0].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding Slots[0].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 1 -->
            <Label Grid.Row="1" Grid.Column="0" Text="{Binding Slots[1].Barcode}" TextColor="Black"/>
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Slots[1].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding Slots[1].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 2 -->
            <Label Grid.Row="2" Grid.Column="0" Text="{Binding Slots[2].Barcode}" TextColor="Black"/>
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Slots[2].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding Slots[2].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 3 -->
            <Label Grid.Row="3" Grid.Column="0" Text="{Binding Slots[3].Barcode}" TextColor="Black"/>
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Slots[3].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding Slots[3].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 4 -->
            <Label Grid.Row="4" Grid.Column="0" Text="{Binding Slots[4].Barcode}" TextColor="Black"/>
            <Label Grid.Row="4" Grid.Column="1" Text="{Binding Slots[4].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="4" Grid.Column="2" Text="{Binding Slots[4].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 5 -->
            <Label Grid.Row="5" Grid.Column="0" Text="{Binding Slots[5].Barcode}" TextColor="Black"/>
            <Label Grid.Row="5" Grid.Column="1" Text="{Binding Slots[5].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="5" Grid.Column="2" Text="{Binding Slots[5].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 6 -->
            <Label Grid.Row="6" Grid.Column="0" Text="{Binding Slots[6].Barcode}" TextColor="Black"/>
            <Label Grid.Row="6" Grid.Column="1" Text="{Binding Slots[6].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="6" Grid.Column="2" Text="{Binding Slots[6].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>

            <!-- Row 7 -->
            <Label Grid.Row="7" Grid.Column="0" Text="{Binding Slots[7].Barcode}" TextColor="Black"/>
            <Label Grid.Row="7" Grid.Column="1" Text="{Binding Slots[7].ScannedQuantity}" HorizontalTextAlignment="Center" TextColor="Black"/>
            <Label Grid.Row="7" Grid.Column="2" Text="{Binding Slots[7].InitialQuantity}" HorizontalTextAlignment="End" TextColor="Black"/>
        </Grid>

        <HorizontalStackLayout Spacing="8">
            <Button Text="Logs" Command="{Binding GoToLogsCommand}" />
            <Button Text="Import Excel" Command="{Binding ImportExcelCommand}" />
            <Button Text="Export Excel" Command="{Binding ExportExcelCommand}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>
