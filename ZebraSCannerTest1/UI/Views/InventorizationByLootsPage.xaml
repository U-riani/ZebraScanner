<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             x:Class="ZebraSCannerTest1.UI.Views.InventorizationByLootsPage"
             Title="Loots Inventory"
             BackgroundColor="#0A0A0F">

    <Grid RowDefinitions="Auto,*" Padding="14" RowSpacing="10">

        <!-- Header / Filter -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Label Text="LOOTS INVENTORY"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="3"
                   HorizontalOptions="Center"
                   Padding="0,12,0,0"/>

            <!-- Search entry in glass card -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="4,0">
                <Entry Placeholder="Scan or enter Box ID..."
                       Text="{Binding FilterText, Mode=TwoWay}"
                       TextColor="#E8EAED"
                       PlaceholderColor="#3D4A5C"
                       ClearButtonVisibility="WhileEditing"
                       Keyboard="Text"
                       FontSize="16"
                       HeightRequest="44" />
            </Border>
        </VerticalStackLayout>

        <!-- Loots List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredLoots}"
                        VerticalScrollBarVisibility="Always"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="#3300D4FF"
                            StrokeThickness="1"
                            BackgroundColor="#1C1C38"
                            Margin="0,5"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventorizationByLootsViewModel}}, Path=OpenLootCommand}"
                                CommandParameter="{Binding Box_Id}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="BOX ID"
                                   TextColor="#6B7A8D"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   LetterSpacing="1"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding Box_Id}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#00D4FF"
                                   HorizontalOptions="Center"/>

                            <FlexLayout HorizontalOptions="Center" Margin="0,4,0,0">
                                <Label Text="{Binding ScannedQuantity}" FontAttributes="Bold" TextColor="#00C97B" FontSize="15"/>
                                <Label Text=" / " Margin="2,0" TextColor="#3D4A5C" FontSize="15"/>
                                <Label Text="{Binding InitialQuantity}" FontAttributes="Bold" TextColor="#6B7A8D" FontSize="15"/>
                            </FlexLayout>

                            <Label Text="{Binding TotalInfo}"
                                   FontSize="12"
                                   HorizontalOptions="Center"
                                   TextColor="#3D4A5C"
                                   Margin="0,2,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
