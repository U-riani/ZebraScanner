<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             x:Class="ZebraSCannerTest1.UI.Views.InventorizationByLootsPage"
             Title="Loots Inventory"
             BackgroundColor="#F5F5F7">

    <Grid RowDefinitions="Auto,*" Padding="14" RowSpacing="10">

        <!-- Header / Filter -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Label Text="Loots Inventory"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   HorizontalOptions="Center"
                   Padding="0,10,0,4"/>

            <Frame CornerRadius="8" Padding="4,0" HasShadow="False"
                   BorderColor="#D0D0D8" BackgroundColor="White">
                <Entry Placeholder="Scan or enter Box ID..."
                       Text="{Binding FilterText, Mode=TwoWay}"
                       TextColor="#111111"
                       PlaceholderColor="#888888"
                       ClearButtonVisibility="WhileEditing"
                       Keyboard="Text"
                       FontSize="18"
                       HeightRequest="48" />
            </Frame>

            <Button Text="SCAN NEW BOX"
                    Command="{Binding OpenNewLootCommand}"
                    BackgroundColor="#6D28D9"
                    TextColor="White"
                    CornerRadius="8"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="48" />
        </VerticalStackLayout>

        <!-- Loots List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredLoots}"
                        VerticalScrollBarVisibility="Always"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8" VerticalOptions="Center">
                    <Label Text="No boxes yet"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#555555"
                           HorizontalOptions="Center"/>
                    <Label Text="Press SCAN NEW BOX to start scanning."
                           FontSize="14"
                           TextColor="#888888"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="14" BorderColor="#D0D0D8"
                           CornerRadius="8" HasShadow="False" BackgroundColor="White">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InventorizationByLootsViewModel}}, Path=OpenLootCommand}"
                                CommandParameter="{Binding Box_Id}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BOX ID"
                                   TextColor="#888888"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   HorizontalOptions="Center"/>
                            <Label Text="{Binding Box_Id}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#00A8CC"
                                   HorizontalOptions="Center"/>
                            <FlexLayout HorizontalOptions="Center" Margin="0,4,0,0">
                                <Label Text="{Binding ScannedQuantity}" FontAttributes="Bold" TextColor="#16A34A" FontSize="17"/>
                                <Label Text=" / " Margin="2,0" TextColor="#888888" FontSize="17"/>
                                <Label Text="{Binding InitialQuantity}" FontAttributes="Bold" TextColor="#555555" FontSize="17"/>
                            </FlexLayout>
                            <Label Text="{Binding TotalInfo}"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   TextColor="#888888"
                                   Margin="0,2,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
