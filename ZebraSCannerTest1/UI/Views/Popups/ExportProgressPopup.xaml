<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZebraSCannerTest1.Views.Popups.ExportProgressPopup">

    <Frame Padding="24"
           BackgroundColor="White"
           CornerRadius="8"
           HasShadow="True"
           BorderColor="#D0D0D8"
           WidthRequest="320">
        <VerticalStackLayout Spacing="14">

            <Label x:Name="TitleLabel"
                   Text="Exporting Data..."
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   HorizontalOptions="Center"/>

            <ProgressBar x:Name="ProgressBar"
                         Progress="0"
                         ProgressColor="#00A8CC"
                         HeightRequest="8"/>

            <Label x:Name="StatusLabel"
                   Text="Preparing..."
                   FontSize="16"
                   TextColor="#555555"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </Frame>
</ContentView>
