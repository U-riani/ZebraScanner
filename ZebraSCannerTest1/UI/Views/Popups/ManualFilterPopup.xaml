<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZebraSCannerTest1.Views.Popups.ManualFilterPopup"
             Title="Manual Filter"
             BackgroundColor="#0A0A0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Title -->
            <Label Text="FILTER BUILDER"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="3"
                   HorizontalOptions="Center"
                   Margin="0,12,0,4"/>

            <!-- Step 1: Select Field -->
            <Label Text="Field" FontAttributes="Bold" FontSize="13" TextColor="#6B7A8D"/>
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="4,0">
                <Picker x:Name="FieldPicker"
                        Title="Choose column"
                        TextColor="#E8EAED"
                        BackgroundColor="Transparent">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Barcode</x:String>
                            <x:String>Name</x:String>
                            <x:String>Color</x:String>
                            <x:String>Size</x:String>
                            <x:String>Price</x:String>
                            <x:String>InitialQuantity</x:String>
                            <x:String>ScannedQuantity</x:String>
                            <x:String>UpdatedAt</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <!-- Step 2: Select Operator -->
            <Label Text="Operator" FontAttributes="Bold" FontSize="13" TextColor="#6B7A8D"/>
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="4,0">
                <Picker x:Name="OperatorPicker"
                        Title="Choose condition"
                        TextColor="#E8EAED"
                        BackgroundColor="Transparent">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>=</x:String>
                            <x:String>&gt;</x:String>
                            <x:String>&lt;</x:String>
                            <x:String>&gt;=</x:String>
                            <x:String>&lt;=</x:String>
                            <x:String>!=</x:String>
                            <x:String>LIKE</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <!-- Step 3: Enter Value -->
            <Label Text="Value" FontAttributes="Bold" FontSize="13" TextColor="#6B7A8D"/>
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="4,0">
                <Entry x:Name="ValueEntry"
                       Placeholder="e.g. BLUE or 10"
                       PlaceholderColor="#3D4A5C"
                       TextColor="#E8EAED"
                       BackgroundColor="Transparent"/>
            </Border>

            <!-- Add Condition -->
            <Button Text="+ Add Condition"
                    Clicked="OnAddConditionClicked"
                    BackgroundColor="#00D4FF"
                    TextColor="#0A0A0F"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    HeightRequest="46"/>

            <!-- Added Conditions -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#12122A"
                    Padding="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ADDED CONDITIONS"
                           FontAttributes="Bold"
                           FontSize="11"
                           LetterSpacing="1"
                           TextColor="#6B7A8D" />
                    <CollectionView x:Name="ConditionsList" HeightRequest="120">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4">
                                    <Label Text="{Binding}"
                                           TextColor="#A066FF"
                                           FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <HorizontalStackLayout Spacing="10" Padding="0,6,0,0" HorizontalOptions="Center">
                <Button Text="✓ Apply Filter"
                        Clicked="OnApplyFilterClicked"
                        BackgroundColor="#00C97B"
                        TextColor="#0A0A0F"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        WidthRequest="148"
                        HeightRequest="46"/>
                <Button Text="✕ Cancel"
                        Clicked="OnCancelClicked"
                        BackgroundColor="#FF4757"
                        TextColor="White"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        WidthRequest="120"
                        HeightRequest="46"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
