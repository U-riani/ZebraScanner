<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ZebraSCannerTest1.UI.Views.TasksPage"
    Title="Inventory Tasks">

    <CollectionView ItemsSource="{Binding Documents}" Background="White">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame  Margin="10" Padding="10" BorderColor="Gray">
                    <VerticalStackLayout>
                        <FlexLayout JustifyContent="SpaceBetween" Direction="Row" >
                            <Label
                                Text="{Binding name}"
                                TextColor="Black"
                                FontSize="18"
                                FontAttributes="Bold" />
                            <Label
                                
                                Text="{Binding doc_type}"
                                TextColor="PaleVioletRed"
                                FontSize="18"
                                FontAttributes="Bold" />
                        </FlexLayout>
                        <Label
                            Text="{Binding status}"
                            FontSize="14"
                            TextColor="Gray" />

                        <Label
                            Text="{Binding created_at}"
                            TextColor="Black"
                            FontSize="12" />

                        <Label
                            Text="{Binding description}"
                            TextColor="Black"
                            FontSize="12" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>