<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZebraSCannerTest1.UI.Views.InventorizationByLootsMenuPage"
             xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             xmlns:views="clr-namespace:ZebraSCannerTest1.UI.Views"
             Title="Loots Menu"
             BackgroundColor="#0A0A0F">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14"
                             VerticalOptions="Center">

            <Label Text="LOOTS INVENTORIZATION"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="3"
                   HorizontalOptions="Center"
                   Margin="0,20,0,8" />

            <!-- CONTINUE -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#3300C97B"
                    StrokeThickness="1"
                    BackgroundColor="#1A3A2A"
                    Padding="0">
                <Button Text="▶  CONTINUE"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#00C97B"
                        HeightRequest="60"
                        Command="{Binding NavigateToContinueCommand}"/>
            </Border>

            <!-- RESULT -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">
                <Button Text="◉  RESULT"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#00D4FF"
                        HeightRequest="60"
                        Command="{Binding NavigateToResultCommand}"/>
            </Border>

            <!-- EXPORT -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">
                <Button Text="↑  EXPORT"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#A066FF"
                        HeightRequest="60"
                        Command="{Binding ExportLootsCommand}"/>
            </Border>

            <!-- IMPORT -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#33FFC107"
                    StrokeThickness="1"
                    BackgroundColor="#3A2E00"
                    Padding="0">
                <Button Text="↓  IMPORT"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#FFC107"
                        HeightRequest="60"
                        Command="{Binding ImportLootsCommand}"/>
            </Border>

            <!-- CLEAR -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#33FF4757"
                    StrokeThickness="1"
                    BackgroundColor="#3A1A1F"
                    Padding="0">
                <Button Text="✕  CLEAR"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#FF4757"
                        HeightRequest="60"
                        Command="{Binding ClearResultCommand}"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
