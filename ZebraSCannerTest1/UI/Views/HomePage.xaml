<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ZebraSCannerTest1.UI.Views"
             xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             x:DataType="viewmodels:HomeViewModel"
             x:Class="ZebraSCannerTest1.UI.Views.HomePage"
             Title="Dashboard"
             BackgroundColor="#0A0A0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Page Title -->
            <Label Text="DASHBOARD"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="3"
                   HorizontalOptions="Center"
                   Margin="0,16,0,4" />

            <!-- INVENTORIZATION Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToInventoryCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="⬡"
                           FontSize="28"
                           TextColor="#00D4FF"
                           HorizontalOptions="Center" />
                    <Label Text="INVENTORIZATION"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#00D4FF"
                           HorizontalOptions="Center" />
                    <Label Text="Scan and manage inventory"
                           FontSize="13"
                           TextColor="#6B7A8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- TRANSFER Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToInventoryCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="⇄"
                           FontSize="28"
                           TextColor="#7B2FFF"
                           HorizontalOptions="Center" />
                    <Label Text="TRANSFER"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#7B2FFF"
                           HorizontalOptions="Center" />
                    <Label Text="Scan and manage inventory"
                           FontSize="13"
                           TextColor="#6B7A8D"
                           HorizontalOptions="Center" />
                    <Label Text="coming soon"
                           FontSize="11"
                           TextColor="#3D4A5C"
                           HorizontalOptions="End"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <!-- RECEIVE Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToInventoryCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="↓"
                           FontSize="28"
                           TextColor="#7B2FFF"
                           HorizontalOptions="Center" />
                    <Label Text="RECEIVE"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#7B2FFF"
                           HorizontalOptions="Center" />
                    <Label Text="Scan and manage inventory"
                           FontSize="13"
                           TextColor="#6B7A8D"
                           HorizontalOptions="Center" />
                    <Label Text="coming soon"
                           FontSize="11"
                           TextColor="#3D4A5C"
                           HorizontalOptions="End"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <!-- SALES Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="20">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToSalesCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label Text="◈"
                           FontSize="28"
                           TextColor="#00D4FF"
                           HorizontalOptions="Center" />
                    <Label Text="SALES"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#00D4FF"
                           HorizontalOptions="Center" />
                    <Label Text="Scan and check sales"
                           FontSize="13"
                           TextColor="#6B7A8D"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
