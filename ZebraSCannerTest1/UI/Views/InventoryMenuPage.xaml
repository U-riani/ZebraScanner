<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZebraSCannerTest1.UI.Views.InventoryMenuPage"
             Title="Inventory Menu"
             BackgroundColor="#0A0A0F">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14"
                             VerticalOptions="Center">

            <Label Text="INVENTORY"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="3"
                   HorizontalOptions="Center"
                   Margin="0,20,0,8" />

            <!-- LOOTS -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">
                <Button Text="📦  LOOTS"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#00D4FF"
                        HeightRequest="60"
                        Clicked="OnLootsClicked"/>
            </Border>

            <!-- BARCODES -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">
                <Button Text="▦  BARCODES"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#A066FF"
                        HeightRequest="60"
                        Clicked="OnBarcodesClicked"/>
            </Border>

            <!-- COMBOS -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">
                <Button Text="⊞  COMBOS"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="#A066FF"
                        HeightRequest="60"
                        Clicked="OnCombosClicked"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
