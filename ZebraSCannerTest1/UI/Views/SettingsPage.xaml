<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             x:Class="ZebraSCannerTest1.UI.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Dark=#0A0F1A, Light=#F8FAFC}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- Title -->
            <Label Text="Settings"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,10" />

            <!-- App version -->
            <Label Text="App version: 1.0.0"
                   FontSize="16"
                   TextColor="{AppThemeBinding Dark=#94A3B8, Light=#64748B}"
                   HorizontalOptions="Center" />

            <!-- Loots-specific buttons – visible only when IsLootsMode = true -->
            <Frame CornerRadius="16"
                   Padding="12"
                   IsVisible="{Binding IsLootsMode}"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Button Text="📊 Stats"
                            Command="{Binding GoToScannedProductsCommand}"
                            CornerRadius="10"
                            HeightRequest="48"
                            FontSize="14"
                            BackgroundColor="#3B82F6"
                            TextColor="White" />

                    <Button Text="📋 Logs"
                            Command="{Binding GoToLogsCommand}"
                            CornerRadius="10"
                            HeightRequest="48"
                            FontSize="14"
                            BackgroundColor="#6B7280"
                            TextColor="White" />

                    <Button Text="📈 Results"
                            Command="{Binding ShowResultsCommand}"
                            CornerRadius="10"
                            HeightRequest="48"
                            FontSize="14"
                            BackgroundColor="#10B981"
                            TextColor="White" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Back button -->
            <Button Text="Back"
                    Command="{Binding BackCommand}"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontSize="16"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>