<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZebraSCannerTest1.UI.Views.LootsScanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
    xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
    Title="Loots Scanning"
    BackgroundColor="#0A0A0F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DifferenceToColorConverter x:Key="DiffToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="10">

            <!-- Current Box Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="14"
                    HorizontalOptions="Center"
                    Margin="0,8,0,4">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="📦" FontSize="22" VerticalOptions="Center" />
                    <Label Text="{Binding CurrentBoxId}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#A066FF"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Barcode Scanner Input -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="6,0">
                <Entry x:Name="lootBarcodeEntry"
                       Placeholder="Scan barcode..."
                       PlaceholderColor="#3D4A5C"
                       TextColor="#E8EAED"
                       FontSize="16"
                       ReturnType="Done"
                       ClearButtonVisibility="WhileEditing"
                       Text="{Binding CurrentBarcode}"
                       Completed="OnBarcodeCompleted" />
            </Border>

            <!-- Table Header -->
            <Border StrokeShape="RoundRectangle 10"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#12122A"
                    Padding="10,8">
                <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*">
                    <Label Text="Barcode"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#00D4FF" />
                    <Label Text="Scanned"
                           Grid.Column="1"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="#6B7A8D" />
                    <Label Text="Initial"
                           Grid.Column="2"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="#6B7A8D" />
                    <Label Text="Diff"
                           Grid.Column="3"
                           FontSize="13"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="#6B7A8D" />
                </Grid>
            </Border>

            <!-- Dynamic Slots -->
            <CollectionView ItemsSource="{Binding Slots}"
                            VerticalScrollBarVisibility="Always"
                            HeightRequest="420">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="#2600D4FF"
                                StrokeThickness="1"
                                Margin="0,3"
                                Padding="10"
                                BackgroundColor="{Binding Difference, Converter={StaticResource DiffToColor}}">

                            <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*">
                                <Label Grid.Column="0"
                                       Text="{Binding Barcode}"
                                       FontSize="14"
                                       TextColor="#E8EAED"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding ScannedQuantity}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#00D4FF"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding InitialQuantity}"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#6B7A8D"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="3"
                                       Text="{Binding Difference}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="#0A0A0F"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LootsScanningViewModel}}, Path=GoToDetailsCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
