<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZebraSCannerTest1.UI.Views.LootsScanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
    xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
    Title="Loots Scanning"
    BackgroundColor="#F5F5F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DifferenceToColorConverter x:Key="DiffToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">

            <!-- Current Box -->
            <Frame CornerRadius="8" Padding="14" HasShadow="True"
                   BorderColor="#D0D0D8" BackgroundColor="White"
                   HorizontalOptions="Center" Margin="0,8,0,4">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="📦" FontSize="22" VerticalOptions="Center" />
                    <Label Text="{Binding CurrentBoxId}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#6D28D9"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Barcode Scanner Input -->
            <Frame CornerRadius="8" Padding="4,0" HasShadow="True"
                   BorderColor="#00A8CC" BackgroundColor="White">
                <Entry x:Name="lootBarcodeEntry"
                       Placeholder="Scan barcode..."
                       PlaceholderColor="#888888"
                       TextColor="#111111"
                       FontSize="18"
                       HeightRequest="52"
                       ReturnType="Done"
                       ClearButtonVisibility="WhileEditing"
                       Text="{Binding CurrentBarcode}"
                       Completed="OnBarcodeCompleted" />
            </Frame>

            <!-- Table Header -->
            <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*"
                  Padding="10,8" BackgroundColor="#EAEAF0">
                <Label Text="Barcode" FontSize="14" FontAttributes="Bold" TextColor="#111111" />
                <Label Text="Scanned" Grid.Column="1" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#555555" />
                <Label Text="Initial"  Grid.Column="2" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#555555" />
                <Label Text="Diff"     Grid.Column="3" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="#555555" />
            </Grid>

            <!-- Dynamic Slots -->
            <CollectionView ItemsSource="{Binding Slots}"
                            VerticalScrollBarVisibility="Always"
                            HeightRequest="420">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="6" Padding="10" Margin="0,3"
                               HasShadow="False" BorderColor="#D0D0D8"
                               BackgroundColor="{Binding Difference, Converter={StaticResource DiffToColor}}">

                            <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*">
                                <Label Grid.Column="0" Text="{Binding Barcode}"
                                       FontSize="15" TextColor="#111111" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ScannedQuantity}"
                                       FontSize="17" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#00A8CC" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding InitialQuantity}"
                                       FontSize="15" HorizontalTextAlignment="Center"
                                       TextColor="#555555" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding Difference}"
                                       FontSize="17" FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="#111111" VerticalOptions="Center" />
                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LootsScanningViewModel}}, Path=GoToDetailsCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
