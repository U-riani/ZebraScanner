<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZebraSCannerTest1.UI.Views.LootsScanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
    xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
    Title="Loots Scanning"
    BackgroundColor="{AppThemeBinding Dark=#0A0F1A, Light=#F8FAFC}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DifferenceToColorConverter x:Key="DiffToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Current Box with Icon + Text (same style as buttons) -->
            <Frame CornerRadius="16"
                   Padding="12"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}"
                   HorizontalOptions="Center"
                   Margin="0,8,0,12">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Box Icon -->
                    <Label Text="📦"
                           FontSize="24"
                           VerticalOptions="Center" />

                    <!-- Box ID Text -->
                    <Label Text="{Binding CurrentBoxId}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Barcode Scanner Input -->
            <Frame CornerRadius="16"
                   Padding="10"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <Entry x:Name="lootBarcodeEntry"
                       Placeholder="Scan barcode..."
                       PlaceholderColor="{AppThemeBinding Dark=#94A3B8, Light=#9CA3AF}"
                       TextColor="{AppThemeBinding Dark=White, Light=Black}"
                       FontSize="16"
                       ReturnType="Done"
                       ClearButtonVisibility="WhileEditing"
                       Text="{Binding CurrentBarcode}"
                       Completed="OnBarcodeCompleted" />
            </Frame>

            <!-- Table Header -->
            <Frame CornerRadius="12"
                   Padding="10,6"
                   HasShadow="False"
                   BorderColor="Transparent"
                   BackgroundColor="{AppThemeBinding Dark=#1F2937, Light=#F1F5F9}">
                <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*">
                    <Label Text="Barcode"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />

                    <Label Text="Scanned"
                           Grid.Column="1"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />

                    <Label Text="Initial"
                           Grid.Column="2"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />

                    <Label Text="Diff"
                           Grid.Column="3"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                </Grid>
            </Frame>

            <!-- Dynamic Slots -->
            <CollectionView ItemsSource="{Binding Slots}"
                            VerticalScrollBarVisibility="Always"
                            HeightRequest="420">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="12"
                               Padding="10"
                               Margin="0,4"
                               HasShadow="True"
                               BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                               BackgroundColor="{Binding Difference, Converter={StaticResource DiffToColor}}">

                            <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*">
                                <Label Grid.Column="0"
                                       Text="{Binding Barcode}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Dark=White, Light=Black}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding ScannedQuantity}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Dark=#60A5FA, Light=#2563EB}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="2"
                                       Text="{Binding InitialQuantity}"
                                       FontSize="15"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Dark=White, Light=Black}"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="3"
                                       Text="{Binding Difference}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       TextColor="{AppThemeBinding Dark=Black, Light=Black}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LootsScanningViewModel}}, Path=GoToDetailsCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>