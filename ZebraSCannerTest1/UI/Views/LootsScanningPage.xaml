<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ZebraSCannerTest1.UI.Views.LootsScanningPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
    xmlns:viewmodels="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
    Title="Loots Scanning"
    BackgroundColor="#F5F5F7">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DifferenceToColorConverter x:Key="DiffToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="10" RowSpacing="5" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Toolbar -->
        <HorizontalStackLayout Grid.Row="0"
                               Spacing="8"
                               Padding="1"
                               HorizontalOptions="CenterAndExpand">
            <Button Text="Stats"
                    Command="{Binding GoToScannedProductsCommand}"
                    BackgroundColor="#00A8CC"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="16"
                    FontAttributes="Bold" />

            <Button Text="Logs"
                    Command="{Binding GoToLogsCommand}"
                    BackgroundColor="#555555"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="16"
                    FontAttributes="Bold" />

            <Button Text="Results"
                    Command="{Binding ShowResultsCommand}"
                    BackgroundColor="#6D28D9"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48"
                    FontSize="16"
                    FontAttributes="Bold" />

            <Button Text="Set Box"
                    Clicked="OnSetBoxClicked"
                    BackgroundColor="OrangeRed"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="44"
                    FontSize="14"
                    FontAttributes="Bold" />
        </HorizontalStackLayout>

        <!-- Current Box -->
        <Frame Grid.Row="1"
               CornerRadius="8"
               Padding="5"
               HasShadow="False"
               BorderColor="#D0D0D8"
               BackgroundColor="White"
               Margin="0,2,0,4">
            <HorizontalStackLayout Spacing="10"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                <Label Text="📦"
                       FontSize="22"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <Label Text="{Binding CurrentBoxDisplay}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#6D28D9"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
        </Frame>

        <!-- Barcode Scanner Input -->
        <Frame Grid.Row="2"
               CornerRadius="8"
               Padding="4,0"
               HasShadow="False"
               BorderColor="#00A8CC"
               BackgroundColor="White">
            <Entry x:Name="lootBarcodeEntry"
                   Placeholder="Scan product barcode..."
                   PlaceholderColor="#888888"
                   TextColor="#111111"
                   FontSize="18"
                   HeightRequest="52"
                   ReturnType="Done"
                   ClearButtonVisibility="Never"
                   Text="{Binding CurrentBarcode, Mode=TwoWay}"
                   Completed="OnBarcodeCompleted"
                   IsTextPredictionEnabled="False" />
        </Frame>

        <!-- Table Header -->
        <Grid Grid.Row="3"
              ColumnDefinitions="3*,1.5*,1.3*,1*"
              Padding="5,8"
              BackgroundColor="#EAEAF0">
            <Label Text="Barcode"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   VerticalTextAlignment="Center" />
            <Label Text="Box/Total"
                   Grid.Column="1"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="#555555" />
            <Label Text="Expected"
                   Grid.Column="2"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   TextColor="#555555" />
            <Label Text="Remain"
                   Grid.Column="3"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center"
                   TextColor="#555555" />
        </Grid>

        <!-- Dynamic Slots -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Slots}"
                        VerticalScrollBarVisibility="Always"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="6"
                           Padding="8,6"
                           Margin="0,3"
                           HasShadow="False"
                           BorderColor="#D0D0D8"
                           BackgroundColor="{Binding Difference, Converter={StaticResource DiffToColor}}">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LootsScanningViewModel}}, Path=GoToDetailsCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="3*,1.7*,1.2*,1.2*"
                              HeightRequest="34"
                              VerticalOptions="Center"
                              InputTransparent="True">
                            <Label Grid.Column="0"
                                   Text="{Binding Barcode}"
                                   FontSize="15"
                                   TextColor="#111111"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Grid.Column="1"
                                   Text="{Binding ScannedDisplay}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="#00A8CC"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Grid.Column="2"
                                   Text="{Binding InitialDisplay}"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="#555555"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label Grid.Column="3"
                                   Text="{Binding DifferenceDisplay}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="End"
                                   VerticalTextAlignment="Center"
                                   TextColor="#111111"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>