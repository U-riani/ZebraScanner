<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             xmlns:models="clr-namespace:ZebraSCannerTest1.Core.Models"
             xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
             x:Class="ZebraSCannerTest1.UI.Views.DetailsPage"
             x:DataType="viewmodel:DetailsViewModel"
             Title="Details"
             BackgroundColor="#0A0A0F">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ManualToColorConverter x:Key="ManualToColor" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:DifferenceToColorConverter x:Key="DifferenceToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#00D4FF"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Barcode Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="16">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="Barcode"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#E8EAED" />
                    <Label Text="{Binding ProductBarcode}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#00D4FF"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}"
                                                 CommandParameter="{Binding ProductBarcode}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Border>

            <!-- Current Box (Loots only) -->
            <Border IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="16">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Current Box"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#E8EAED" />
                    <Label Text="{Binding BoxId}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#A066FF" />
                </HorizontalStackLayout>
            </Border>

            <!-- In Boxes (Loots only) -->
            <Border IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                    StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#12122A"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="In Boxes"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#E8EAED" />
                    <Label Text="{Binding AllBoxesInfo}"
                           FontSize="15"
                           TextColor="#6B7A8D"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Product Details Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Artic Code" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ProductArticCode}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#E8EAED">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}"
                                                     CommandParameter="{Binding ProductArticCode}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Name" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ProductName}" FontSize="15" TextColor="#E8EAED" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Color" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ProductColor}" FontSize="15" TextColor="#E8EAED" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Size" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ProductSize}" FontSize="15" TextColor="#E8EAED" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Price" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ProductPrice, StringFormat='{}{0} ₾'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#00D4FF" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Totals & Quantities Card -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#337B2FFF"
                    StrokeThickness="1"
                    BackgroundColor="#12122A"
                    Padding="16">
                <VerticalStackLayout Spacing="12">

                    <!-- Loots mode totals -->
                    <VerticalStackLayout IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}" Spacing="10">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="Total Initial (all boxes)" FontSize="14" TextColor="#6B7A8D" />
                            <Label Text="{Binding TotalInitialQuantity}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#E8EAED" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="Total Scanned (all boxes)"
                                   FontSize="14"
                                   TextColor="#6B7A8D"
                                   VerticalOptions="Center" />
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding ScannedVsInitialDifference, Converter={StaticResource DifferenceToColorConverter}}"
                                    Padding="14,6">
                                <Label Text="{Binding TotalScannedQuantity}"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       TextColor="#0A0A0F"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Always visible quantities -->
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Initial Quantity" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding InitialQuantity}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#E8EAED" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Scanned Quantity" FontSize="14" TextColor="#6B7A8D" />
                        <Label Text="{Binding ScannedQuantity}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#E8EAED" />
                    </HorizontalStackLayout>

                    <!-- Difference -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Difference"
                               FontSize="14"
                               TextColor="#6B7A8D"
                               VerticalOptions="Center" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                BackgroundColor="{Binding Difference, Converter={StaticResource DifferenceToColorConverter}}"
                                Padding="14,6">
                            <Label Text="{Binding Difference}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#0A0A0F"
                                   VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Border IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="16">
                <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Button Text="✎"
                            Command="{Binding ManualEditCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="26"
                            CornerRadius="12"
                            BackgroundColor="#7B2FFF"
                            TextColor="White" />

                    <Button Text="−"
                            Command="{Binding DecrementCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="32"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="#FF4757"
                            TextColor="White" />

                    <Button Text="+"
                            Command="{Binding IncrementCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="32"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="#00C97B"
                            TextColor="#0A0A0F" />
                </HorizontalStackLayout>
            </Border>

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    Margin="0,4,0,16"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"
                    IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#00D4FF"
                    TextColor="#0A0A0F" />

            <!-- Logs Header -->
            <Label Text="SCAN / EDIT HISTORY"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#6B7A8D"
                   LetterSpacing="2"
                   Margin="4,8,4,4" />

            <!-- Logs Table -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#3300D4FF"
                    StrokeThickness="1"
                    BackgroundColor="#1C1C38"
                    Padding="0">

                <VerticalStackLayout Spacing="0">

                    <!-- Logs Table Header -->
                    <Grid ColumnDefinitions="3*, 60, 60, 60, 80, 80"
                          Padding="12,10"
                          BackgroundColor="#12122A">
                        <Label Text="Barcode" FontSize="13" FontAttributes="Bold" TextColor="#00D4FF" />
                        <Label Text="Was"    Grid.Column="1" FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D" HorizontalTextAlignment="Center" />
                        <Label Text="IncBy"  Grid.Column="2" FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D" HorizontalTextAlignment="Center" />
                        <Label Text="Now"    Grid.Column="3" FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D" HorizontalTextAlignment="Center" />
                        <Label Text="Sctn"
                               Grid.Column="4"
                               IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Standard}"
                               FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Box"
                               Grid.Column="4"
                               IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                               FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Time" Grid.Column="5" FontSize="13" FontAttributes="Bold" TextColor="#6B7A8D" HorizontalTextAlignment="End" />
                    </Grid>

                    <!-- Logs Collection -->
                    <CollectionView ItemsSource="{Binding Logs}"
                                    HeightRequest="260"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScanLog">
                                <Border StrokeShape="RoundRectangle 0"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding IsManual, Converter={StaticResource ManualToColor}}"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="3*,60,60,60,80,80">
                                        <Label Grid.Column="0" Text="{Binding Barcode}" FontSize="13" TextColor="#E8EAED" />
                                        <Label Grid.Column="1" Text="{Binding Was}" HorizontalTextAlignment="Center" FontSize="13" TextColor="#6B7A8D" />
                                        <Label Grid.Column="2" Text="{Binding IncrementBy}" HorizontalTextAlignment="Center" FontSize="13" TextColor="#00D4FF" />
                                        <Label Grid.Column="3" Text="{Binding IsValue}" HorizontalTextAlignment="Center" FontSize="13" TextColor="#E8EAED" />
                                        <Label Grid.Column="4"
                                               Text="{Binding Section, FallbackValue='—'}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DetailsViewModel}}, Path=CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Standard}"
                                               HorizontalTextAlignment="Center" FontSize="13" TextColor="#A066FF" />
                                        <Label Grid.Column="4"
                                               Text="{Binding Box_Id, FallbackValue='—'}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DetailsViewModel}}, Path=CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                                               HorizontalTextAlignment="Center" FontSize="13" TextColor="#A066FF" />
                                        <Label Grid.Column="5"
                                               Text="{Binding UpdatedAt, StringFormat='{0:dd/MM HH:mm:ss}'}"
                                               FontSize="12"
                                               TextColor="#3D4A5C"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
