<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             xmlns:models="clr-namespace:ZebraSCannerTest1.Core.Models"
             xmlns:converters="clr-namespace:ZebraSCannerTest1.UI.Converters"
             x:Class="ZebraSCannerTest1.UI.Views.DetailsPage"
             x:DataType="viewmodel:DetailsViewModel"
             Title="Details"
             BackgroundColor="{AppThemeBinding Dark=#0A0F1A, Light=#F8FAFC}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ManualToColorConverter x:Key="ManualToColor" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:DifferenceToColorConverter x:Key="DifferenceToColorConverter" />
            <!-- You can remove QuantityComparisonToColorConverter if not used elsewhere -->
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{AppThemeBinding Dark=#60A5FA, Light=#2563EB}"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <!-- Barcode -->
            <Frame CornerRadius="16"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="Barcode"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    <Label Text="{Binding ProductBarcode}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=#60A5FA, Light=#2563EB}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}"
                                                 CommandParameter="{Binding ProductBarcode}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </Frame>

            <!-- Current Box (Loots only) -->
            <Frame IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                   CornerRadius="14"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="Current Box"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    <Label Text="{Binding BoxId}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                </HorizontalStackLayout>
            </Frame>

            <!-- In Boxes (Loots only) -->
            <Frame IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                   CornerRadius="14"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#0F172A, Light=#F1F5F9}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="In Boxes"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    <Label Text="{Binding AllBoxesInfo}"
                           FontSize="15"
                           TextColor="{AppThemeBinding Dark=#94A3B8, Light=#64748B}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Product Details Card -->
            <Frame CornerRadius="16"
                   Padding="18"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Artic Code" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ProductArticCode}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CopyBarcodeCommand}"
                                                     CommandParameter="{Binding ProductArticCode}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Name" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ProductName}" FontSize="17" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Color" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ProductColor}" FontSize="17" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Size" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ProductSize}" FontSize="17" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Price" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ProductPrice, StringFormat='{}{0} ₾'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark=#60A5FA, Light=#2563EB}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Totals & Quantities Card -->
            <Frame CornerRadius="14"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#0F172A, Light=#F1F5F9}">
                <VerticalStackLayout Spacing="14">

                    <!-- Loots mode totals -->
                    <VerticalStackLayout IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}" Spacing="12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="Total Initial (all boxes)" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                            <Label Text="{Binding TotalInitialQuantity}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="Total Scanned (all boxes)"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Dark=White, Light=Black}"
                                   VerticalOptions="Center" />
                            <Frame CornerRadius="10"
                                   Padding="14,8"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding ScannedVsInitialDifference, Converter={StaticResource DifferenceToColorConverter}}">
                                <Label Text="{Binding TotalScannedQuantity}"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Dark=Black, Light=Black}"
                                       VerticalOptions="Center" />
                            </Frame>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Always visible quantities -->
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Initial Quantity" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding InitialQuantity}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Scanned Quantity" FontSize="16" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="{Binding ScannedQuantity}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                    </HorizontalStackLayout>

                    <!-- Difference -->
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="Difference"
                               FontSize="16"
                               TextColor="{AppThemeBinding Dark=White, Light=Black}"
                               VerticalOptions="Center" />
                        <Frame CornerRadius="10"
                               Padding="14,8"
                               BackgroundColor="{Binding Difference, Converter={StaticResource DifferenceToColorConverter}}"
                               HasShadow="False"
                               BorderColor="Transparent">
                            <Label Text="{Binding Difference}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Dark=Black, Light=Black}"
                                   VerticalOptions="Center" />
                        </Frame>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Frame IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                   CornerRadius="20"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">
                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button Text="✎"
                            Command="{Binding ManualEditCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="28"
                            CornerRadius="12"
                            BackgroundColor="#3B82F6"
                            TextColor="White" />

                    <Button Text="−"
                            Command="{Binding DecrementCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="32"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="#EF4444"
                            TextColor="White" />

                    <Button Text="+"
                            Command="{Binding IncrementCommand}"
                            WidthRequest="64"
                            HeightRequest="64"
                            FontSize="32"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            BackgroundColor="#10B981"
                            TextColor="White" />
                </HorizontalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Command="{Binding SaveCommand}"
                    Margin="0,8,0,24"
                    CornerRadius="12"
                    HeightRequest="56"
                    FontSize="18"
                    FontAttributes="Bold"
                    IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#3B82F6"
                    TextColor="White" />

            <!-- Logs Header -->
            <Label Text="Scan / Edit History"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=White, Light=Black}"
                   Margin="4,12,4,8" />

            <Frame CornerRadius="14"
                   Padding="0"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Dark=#1F2937, Light=#E2E8F0}"
                   BackgroundColor="{AppThemeBinding Dark=#111827, Light=White}">

                <VerticalStackLayout Spacing="0">

                    <!-- Logs Table Header -->
                    <Grid ColumnDefinitions="3*, 60, 60, 60, 80, 80"
                          Padding="12,10"
                          BackgroundColor="{AppThemeBinding Dark=#1F2937, Light=#F1F5F9}">
                        <Label Text="Barcode" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                        <Label Text="Was"    Grid.Column="1" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}" HorizontalTextAlignment="Center" />
                        <Label Text="IncBy"  Grid.Column="2" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}" HorizontalTextAlignment="Center" />
                        <Label Text="Now"    Grid.Column="3" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}" HorizontalTextAlignment="Center" />
                        <Label Text="Sctn"
                               Grid.Column="4"
                               IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Standard}"
                               FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Box"
                               Grid.Column="4"
                               IsVisible="{Binding CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                               FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Time" Grid.Column="5" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=White, Light=Black}" HorizontalTextAlignment="End" />
                    </Grid>

                    <!-- Logs Collection -->
                    <CollectionView ItemsSource="{Binding Logs}"
                                    HeightRequest="260"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScanLog">
                                <Border StrokeShape="RoundRectangle 0"
                                        BackgroundColor="{Binding IsManual, Converter={StaticResource ManualToColor}}"
                                        Padding="12,10">
                                    <Grid ColumnDefinitions="3*,60,60,60,80,80">
                                        <Label Grid.Column="0" Text="{Binding Barcode}" FontSize="14" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                        <Label Grid.Column="1" Text="{Binding Was}" HorizontalTextAlignment="Center" FontSize="14" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                        <Label Grid.Column="2" Text="{Binding IncrementBy}" HorizontalTextAlignment="Center" FontSize="14" TextColor="{AppThemeBinding Dark=#60A5FA, Light=#2563EB}" />
                                        <Label Grid.Column="3" Text="{Binding IsValue}" HorizontalTextAlignment="Center" FontSize="14" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                        <Label Grid.Column="4"
                                               Text="{Binding Section, FallbackValue='(none)'}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DetailsViewModel}}, Path=CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Standard}"
                                               HorizontalTextAlignment="Center" FontSize="14" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                        <Label Grid.Column="4"
                                               Text="{Binding Box_Id, FallbackValue='(none)'}"
                                               IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:DetailsViewModel}}, Path=CurrentMode, Converter={StaticResource EnumEqualsConverter}, ConverterParameter=Loots}"
                                               HorizontalTextAlignment="Center" FontSize="14" TextColor="{AppThemeBinding Dark=White, Light=Black}" />
                                        <Label Grid.Column="5"
                                               Text="{Binding UpdatedAt, StringFormat='{0:dd/MM HH:mm:ss}'}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Dark=#94A3B8, Light=#64748B}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>