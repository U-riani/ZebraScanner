<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZebraSCannerTest1.UI.Views.SalesMenuPage"
             xmlns:viewModel="clr-namespace:ZebraSCannerTest1.UI.ViewModels"
             Title="Sales"
             BackgroundColor="#F5F5F7">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12" VerticalOptions="Center"
                             x:DataType="viewModel:SalesMenuViewModel">

            <Label Text="Sales"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#111111"
                   HorizontalOptions="Center"
                   Margin="0,20,0,12" />

            <Button Text="CONTINUE"
                    FontSize="20" FontAttributes="Bold"
                    BackgroundColor="#16A34A" TextColor="White"
                    CornerRadius="8" HeightRequest="60"
                    Command="{Binding NavigateToSalesPageCommand}"/>

            <Button Text="IMPORT"
                    FontSize="20" FontAttributes="Bold"
                    BackgroundColor="#D97706" TextColor="White"
                    CornerRadius="8" HeightRequest="60"
                    Command="{Binding OnImportSalesDataCommand}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
